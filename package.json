{
  "name": "@kvasar/cli",
  "version": "0.2.0",
  "description": "AI-native CLI and MCP server for Kvasar Agile Management — epics, features, PIs, ARTs, sprint planning, AI workflows, and Jira integrations",
  "type": "module",
  "bin": {
    "kvasar": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck",
    "prepack": "npm run build",
    "postpack": "node -e \"console.log('Validated: npm pack completed — verify contents in .tgz')\"",
    "version:patch": "npm version patch -m \"chore(release): bump to %s [skip ci]\"",
    "version:minor": "npm version minor -m \"chore(release): bump to %s [skip ci]\"",
    "version:major": "npm version major -m \"chore(release): bump to %s [skip ci]\""
  },
  "keywords": [
    "kvasar",
    "kvasar-agile-management",
    "agile",
    "safe",
    "scaled-agile-framework",
    "project-management",
    "portfolio-management",
    "pi-planning",
    "art",
    "epics",
    "features",
    "sprints",
    "jira",
    "ai",
    "ai-agent",
    "automation",
    "mcp",
    "model-context-protocol",
    "cli",
    "developer-tools",
    "enterprise-agile"
  ],
  "author": "Kvasar Technologies",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "commander": "^14.0.3",
    "jose": "^5.0.0",
    "keytar": "^7.9.0",
    "openid-client": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kvasar-Technologies/Kvasar-Agile-Management-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/Kvasar-Technologies/Kvasar-Agile-Management-CLI/issues"
  },
  "homepage": "https://landing.kvasar.tech"
}
